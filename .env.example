# Configuración web de Firebase (Consola → Configuración del proyecto → Tus apps).
# No son secretos. En Vercel se definen en Settings → Environment Variables;
# para desarrollo, copia este archivo como .env.local. Sin ellos, la app funciona sin cuenta.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
